        "ggf4b_sUHIl_srcSet_desktop_src": "https://placehold.co/1327x1726?text=Image",
        "ggf4b_sUHIl_srcSet_mobile_src": "https://placehold.co/1327x1726?text=Image",
        "ggnO3IZhWSI_text": "<span style=\"font-size:24px;\"><strong>Por qué tomar café con</strong></span>",
        "ggtWNQTuQsg_text": "<strong>hongos funcionales</strong>",
        "ggyqrgD1Wh5_text": "<p><span style=\"font-size:19px;\"><strong>Dr. Juan Pablo Hernández</strong></span></p><p><span style=\"color:#DE633B;\">Médico nutriólogo</span></p>"
