    "gp_section_630419793233118148": {
      "settings": {
        "checksum": "b3989dd60bd86682193d04e3cd4217f813146d6370d82589c643af45bec69cca_1_1_1_0__1",
        "gg01lrLk3mc_text": "<p>Entrega de 2 a 3</p><p>días hábiles.</p>",
        "gg3Gk89E5Gb_text": "<p>Envío</p><p><strong>GRATIS</strong></p>",
        "gg3b7O0vDSS_text": "<p><strong>Dr. Juan Pablo Hernández</strong></p><p><span style=\"color:#D46C23;\">Médico nutriólogo</span></p>",
        "gg5WGFTmkYe_text": "<p><span style=\"background-color:transparent;color:#593814;font-size:12pt;\">Hace 2 años, la curiosidad médica me llevó a descubrir las&nbsp;extraordinarias propiedades de los&nbsp;<strong>hongos funcionales</strong>, y aún me sorprende que tan pocas personas en Latinoamérica estén aprovechando sus beneficios...</span></p><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#593814;font-size:12pt;\">Como&nbsp;<strong>médico nutriólogo</strong> y amante del café, vi la oportunidad perfecta para fusionar lo mejor de ambos mundos. Así nació&nbsp;<strong>FUNGI Café</strong>.</span></p><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#593814;font-size:12pt;\">Su delicioso sabor y sus propiedades</span></p><p><span style=\"background-color:transparent;color:#593814;font-size:12pt;\"><strong>transformarán tus mañanas</strong> y tu rutina.</span></p>",
        "ggB256uCzUr_srcSet_desktop_src": "https://placehold.co/1327x1726?text=Image",
        "ggB256uCzUr_srcSet_mobile_src": "https://placehold.co/1327x1726?text=Image",
        "ggLRxxTdmdL_label": "<p>QUIERO EL MÍO&nbsp;</p>",
        "ggLS3bzChs3_text": "<p><span style=\"background-color:transparent;color:#593814;font-size:12pt;\">He visto el&nbsp;<strong>impacto positivo</strong> en cientos de personas, y ahora quiero verlo en ti. Por eso, te invito a unirte a este selecto grupo de personas que hacemos parte de&nbsp;<strong>FUNGI Café Club</strong>.</span></p><p>&nbsp;</p><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#593814;font-size:12pt;\">Cordialmente,</span><br><span style=\"background-color:transparent;color:#593814;font-size:12pt;\"><i><strong>Dr.&nbsp;</strong>Juan Pablo Hernández – Médico Nutriólogo</i></span></p><p>&nbsp;</p><p>&nbsp;</p><p><span style=\"background-color:transparent;color:#593814;font-size:12pt;\"><i><strong>PD</strong></i><strong>:</strong> Tu familia y amigos te van a preguntar qué café tomas... invítalos a un FUNGI☕️</span><span style=\"background-color:transparent;color:#593814;font-size:11pt;\">🍄</span></p>",
        "ggawzMDYMNm_text": "<p>Si no te gusta devolvemos tu dinero.</p>",
        "ggeYxBaeD9G_background_desktop_image_src": "https://placehold.co/1440x685?text=Image",
        "ggeYxBaeD9G_background_mobile_image_src": "https://placehold.co/375x1083?text=Image",
