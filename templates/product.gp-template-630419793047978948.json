    "gp_section_630419793232856004": {
      "settings": {
        "checksum": "e43d275513e6938d2b4472d24b616f9a629a502910462c03e68afe9b91b5b982_1_1_1_0__1",
        "ggDDC3cjCFa_text": "<p><span style=\"background-color:transparent;font-size:14px;\">El café está listo para su consumo. Sencillamente agrega un sachet de FUNGI Café a un vaso de 200 ml de agua o leche caliente y disuelve.</span></p>",
        "ggMAF0Lib7P_text": "<p><strong>Preguntas Frecuentes</strong></p>",
        "ggMWWGPVkDX_text": "<p><span style=\"background-color:transparent;font-size:inherit;\">Es seguro tomarlo después del tercer mes de embarazo, sin embargo se recomienda supervisión médica.</span></p>",
        "ggNtZzOB8wN_srcSet_desktop_src": "https://placehold.co/749x130?text=Image",
        "ggg6IRlkgL5_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(33,25,22);font-size:14px;\">Nos gusta consumir FUNGI Café varias veces al día. Sin embargo, te recomendamos tomarlo en la mañana. Es la manera perfecta de empezar el día.</span></p>",
        "ggiaGS_Li44_text": "<p><span style=\"background-color:transparent;font-size:inherit;\">Sí, el registro INVIMA de FUNGI Café es RSA-0031906-2024.</span></p>",
        "ggpQAnp9N0L_text": "<p><span style=\"background-color:transparent;font-size:inherit;\">FUNGI café contiene hongos funcionales y adaptógenos por lo que no presenta ningún tipo de efecto secundario o psicodélico. No contiene psilocibina.</span></p>",
        "ggy7rSJLzsN_childItem_0": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Cómo se toma?</span></p>",
        "ggy7rSJLzsN_childItem_1": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Cúal es el mejor horario para consumirlo?</span></p>",
        "ggy7rSJLzsN_childItem_2": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Está avalado por el INVIMA?</span></p>",
        "ggy7rSJLzsN_childItem_3": "<p><span style=\"background-color:rgba(236,229,214,0);color:rgb(33,25,22);font-size:14px;\">¿Tiene efectos secundarios?</span></p>",
        "ggy7rSJLzsN_childItem_4": "<p><span style=\"background-color:rgba(236, 229, 214, 0);color:rgb(33,25,22);font-size:14px;\">¿Se puede tomar durante el embarazo o lactancia?</span></p>"
