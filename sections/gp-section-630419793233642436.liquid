    aspect-ratio:1/1;
    object-fit:cover;
    border-radius:8px;

}

/* ===========================
THUMBNAILS
=========================== */

.gp-thumbs{

    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:12px;

    margin-top:14px;

}

.gp-thumb{

    border-radius:8px;
    overflow:hidden;
    cursor:pointer;

    border:2px solid transparent;
    transition:.25s;

}

.gp-thumb.active{
