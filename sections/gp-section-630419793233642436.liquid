#fungi-2m .f2m-price{font-size:18px;font-weight:700;margin:0 0 10px;}
#fungi-2m .f2m-inner{display:flex;align-items:center;gap:10px;background:#fff;border-radius:11px;padding:11px 12px;margin-bottom:11px;}
#fungi-2m .f2m-txt{flex:1;}
#fungi-2m .f2m-tag{display:inline-block;background:#E8722E;color:#fff;font-weight:600;font-size:11px;letter-spacing:.2px;padding:4px 9px;border-radius:5px;margin-bottom:7px;}
#fungi-2m .f2m-row{font-size:12.5px;margin-bottom:6px;}
#fungi-2m .f2m-b{font-weight:600;}
#fungi-2m .f2m-accent{color:#E8722E;font-style:italic;}
#fungi-2m .f2m-li{display:flex;align-items:center;gap:6px;font-size:11.5px;font-style:italic;color:#5a5a5a;margin-top:4px;}
#fungi-2m .f2m-ck{display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;background:#E8722E;color:#fff;font-style:normal;font-size:9px;flex:none;}
#fungi-2m .f2m-img{width:80px;height:auto;flex:none;border-radius:6px;}
#fungi-2m .f2m-btn{display:block;text-align:center;text-decoration:none;background:linear-gradient(90deg,#E8722E,#2FA39E);color:#fff;font-weight:700;font-size:14px;padding:11px;border-radius:999px;}
@media(max-width:600px){#fungi-2m{width:auto;margin-left:0px;margin-right:0px;}}
@media(max-width:430px){#fungi-2m .f2m-img{width:66px;}}
</style>

<script>
(function(){
  /* ====== EDITA AQUÍ ====== */
  var LINK_OFF = "https://treli.co/payment-plan/?username=fungicafeclub&product_id=1770802&quantity=1&plan_id=0&plan_currency=COP";
  var LINK_ON  = "https://checkout.treli.co/pl/pl_RoUxhtuMBMARlUEhpaDUv5Ha";
  var IMG = "https://cdn.shopify.com/s/files/1/0603/6950/2323/files/empaque-photoshopeado_1.webp?v=1762792413";
  /* ======================== */

  var box=document.getElementById("fungi-2m");
  if(!box)return;
  var btn=box.querySelector("[data-btn]"), img=box.querySelector("[data-img]");
  if(img) img.src=IMG;
  var tabs=box.querySelectorAll(".f2m-tab");
  function set(m){
    for(var i=0;i<tabs.length;i++){tabs[i].classList.toggle("is-active",tabs[i].getAttribute("data-mode")===m);}
    btn.setAttribute("href",(m==="on")?LINK_ON:LINK_OFF);
  }
  for(var i=0;i<tabs.length;i++){tabs[i].addEventListener("click",function(){set(this.getAttribute("data-mode"));});}
  set("off");
})();
